{
  "name": "sara-core",
  "version": "0.1.0",
  "private": true,
  "description": "Sara Core monorepo — generation and simulation of plausible digital ecosystems.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "free-ports": "node scripts/free-ports.mjs 3333 5180",
    "predev": "node scripts/free-ports.mjs 3333 5180",
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm run dev -w @sara/backend\" \"npm run dev -w @sara/frontend\"",
    "predev:backend": "node scripts/free-ports.mjs 3333",
    "dev:backend": "npm run dev -w @sara/backend",
    "predev:frontend": "node scripts/free-ports.mjs 5180",
    "dev:frontend": "npm run dev -w @sara/frontend",
    "celular": "node scripts/serve-lan.mjs",
    "build": "npm run build --workspaces --if-present",
    "demo:pack": "npm run build -w @sara/frontend && node scripts/check-pwa-budget.mjs && node scripts/demo-pack.mjs",
    "start:local": "node scripts/start-local.mjs",
    "portable:pack": "npm run build && node scripts/portable-pack.mjs",
    "test:portable": "node --test scripts/local-gateway.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/local-gateway.test.mjs",
    "test:frontend": "npm run test -w @sara/frontend",
    "android:sync": "npm run cap:sync -w @sara/frontend",
    "android:open": "npm run cap:open -w @sara/frontend",
    "android:apk": "npm run apk:debug -w @sara/frontend",
    "android:apk:copy": "npm run apk:copy -w @sara/frontend",
    "db:check": "npm run db:check -w @sara/backend",
    "db:migrate": "npm run db:migrate -w @sara/backend",
    "db:reset": "npm run db:reset -w @sara/backend",
    "db:seed": "npm run db:seed -w @sara/backend",
    "build:web": "node scripts/build-web.mjs",
    "test:web": "node --test scripts/web-entry.test.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
