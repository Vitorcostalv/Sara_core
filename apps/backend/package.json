{
  "name": "@sara/backend",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP orchestrator backend for Sara Core.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test src/modules/llm/providers/gemini.provider.test.ts src/modules/llm/providers/grok.provider.test.ts src/http/http.integration.test.ts src/database/environmental-ecology.foundation.test.ts src/modules/ecology/ecology.grounding.test.ts src/modules/ecology/ecology.simulation.test.ts src/modules/ecology/ecology.knowledge-layer.test.ts src/modules/ecology/ecology.curated-data.test.ts",
    "db:migrate": "tsx src/database/migrate-postgres.ts",
    "db:reset": "tsx src/database/reset-postgres.ts",
    "db:seed": "tsx src/database/seed-postgres.ts",
    "db:check": "tsx src/database/check-postgres.ts"
  },
  "dependencies": {
    "pg": "^8.14.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "eslint": "^9.38.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}

